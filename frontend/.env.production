# Baked into the production build at build time (Vite only exposes VITE_-prefixed
# vars, and they're not secret -- this URL ends up visible in the shipped JS bundle
# regardless of where it's set, so committing it here is fine).
#
# This is the URL Render will assign the backend service defined in render.yaml,
# based on the service name "worldcup-ai-backend". If that name was already taken
# on Render and it got a different URL instead, update this line to match and
# redeploy the frontend on Vercel.
VITE_API_BASE=https://worldcup-ai-backend.onrender.com
